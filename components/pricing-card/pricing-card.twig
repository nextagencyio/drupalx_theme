<div class="rounded-xl bg-card text-card-foreground shadow flex h-full flex-col justify-between p-6 md:p-8 border border-border-primary">
	<div>
		<h2 class="mb-2 text-md font-bold leading-[1.4] md:text-xl">{{ eyebrow }}</h2>
		<h3 class="my-2 text-3xl font-bold lg:text-4xl">
			{{ title }}
			{% if monthly_label %}
				<span class="text-xl font-bold md:leading-[1.3] lg:text-2xl">/{{ monthly_label }}</span>
			{% endif %}
		</h3>
		<div class="my-8 h-px w-full bg-border"></div>
		<p>{{ includes_label|default('Includes') }}:</p>
		<div class="mb-8 mt-4 grid grid-cols-1 gap-y-4 py-2">
			{% for feature in features %}
				<div class="flex self-start">
					<div
						class="mr-4 flex-none self-start">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-6"><path d="M20 6 9 17l-5-5"></path></svg>
					</div>
					<p>{{ feature }}</p>
				</div>
			{% endfor %}
		</div>
	</div>
	{% if cta_link %}
		<div>
			{% include '@drupalx_theme/button/button.twig' with {
				button: {
					url: cta_link.url,
					text: cta_link.title,
					modifier: 'btn-default w-full'
				}
			} only %}
		</div>
	{% endif %}
</div>
