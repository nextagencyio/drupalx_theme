{% set alignment_class = layout == 'left' ? 'text-left' : 'text-center' %}
{% set icon_class = layout == 'left' ? 'mr-auto' : 'mx-auto' %}

<div class="stat {{ alignment_class }} {{ not border ? 'border-0 shadow-none px-4 py-8 h-full' : '' }} {{ modifier }}">
	<div class="pt-6 {{ not border ? 'p-0' : '' }}">
		{% if icon %}
			<div class="stat-icon {{ icon_class }} mb-4 max-w-[200px]">
				<span class="material-symbols-outlined !text-6xl">{{ icon }}</span>
			</div>
		{% endif %}
		{% if media %}
			<div class="stat-icon {{ icon_class }} mb-4 max-w-[200px]">
				{{ media }}
			</div>
		{% endif %}
		<h3 class="mb-2 text-xl">{{ heading }}</h3>
		{% if body %}
			<p class="mb-0 text-gray-600">{{ body }}</p>
		{% endif %}
	</div>
</div>
