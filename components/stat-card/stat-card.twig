<div class="rounded-xl bg-card text-card-foreground stat text-center border-0 shadow-none px-4 py-8 h-full">

	<div class="p-0">
		{% if icon %}
			<div class="stat-icon mx-auto mb-4 max-w-[200px]">
				<span class="material-symbols-outlined !text-6xl">{{ icon }}</span>
			</div>
		{% endif %}
		{% if media %}
			<div class="stat-icon mr-auto mb-4 max-w-[200px]">
				{{ media }}
			</div>
		{% endif %}
		<h3 class="font-semibold tracking-tight mb-2 text-xl">{{ heading }}</h3>

		{% if body %}
			<p class="mb-0 text-gray-600">{{ body }}</p>
		{% endif %}
	</div>
</div>
