<div class="bg-gray-100 text-gray-900">
	<div class="py-8 lg:py-24 {{ modifier ?: 'container mx-auto px-8' }}">
		<div
			class="flex flex-col lg:space-y-8">

			{# Header Section #}
			<div class="flex flex-col justify-center">
				<h2 class="text-3xl font-semibold mb-4 sm:text-4xl">{{ title }}</h2>
				<div class="newsletter-summary">
					{{ summary }}
				</div>
			</div>

			{# Newsletter Form Section #}
			<div class="mt-6 lg:mt-0">
				<div class="md:w-3/4 xl:w-1/2">
					<div
						class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-2">

						{# Email Input #}
						<input
						type="email" class="flex-grow bg-white text-xl h-12 px-4 border border-gray-300 rounded" placeholder="Email Address" aria-label="Email Address" name="newsletter_email" required/>

						{# Submit Button #}
						<button class="bg-gray-900 text-white hover:bg-gray-700 text-xl h-12 px-6 rounded" type="submit">
							Submit
						</button>

					</div>
				</div>
			</div>

		</div>
	</div>
</div>
