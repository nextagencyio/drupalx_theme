<hr class="my-4"/>
<div
  class="flex flex-col items-center space-y-4 pt-3 pb-10 md:flex-row md:justify-between md:space-y-0">
  <!-- Left Section -->
  <div class="text-center md:text-left md:w-1/3">
    <p class="text-muted-foreground">© 2024 DrupalX</p>
  </div>

  <!-- Center Section -->
  <div class="flex justify-center md:w-1/3">
    <a href="/" class="flex items-center justify-center">
      <img src="{{ site_logo }}" width="200" alt="{{ site_name }}"/>
    </a>
  </div>

  <!-- Right Section -->
  <nav class="md:w-1/3">
    {% block content %}
      {% include '@drupalx_theme/menu/menu.twig' with {
        modifier: "",
        menu_items: links,
        item_modifier: ""
      } only %}
    {% endblock %}
  </nav>
</div>
