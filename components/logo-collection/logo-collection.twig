<section class="py-8 md:py-12 bg-white">
	<div class="container mx-auto px-4">
		<div class="flex flex-col md:flex-row md:items-center">
			<h2 class="text-xl font-bold text-gray-800 mb-4 md:mb-0 md:w-1/5 md:pr-4 md:flex-shrink-0">
				{{ title }}
			</h2>
			<div class="flex flex-wrap justify-start md:justify-end items-center gap-4 md:gap-8 md:w-5/6">
				{% block logo_items %}
					{% for logo in logos %}
						<div class="flex items-center">
							{% if logo.media is not empty %}
								<div class="max-w-[120px]">
									{{ logo.media }}
								</div>
							{% endif %}
						</div>
					{% endfor %}
				{% endblock %}
			</div>
		</div>
	</div>
</section>
