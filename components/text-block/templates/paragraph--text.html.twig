
{#
/**
 * @file
 * Default theme implementation to display a block content.
 *
 * @see template_preprocess_block_content_template()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = []
%}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% block content %}
    {%
      include 'drupalx_theme:text-block' with {
        text_layout: content.field_text_layout|field_value|render|trim|striptags,
        title: content.field_title|render,
        eyebrow: content.field_eyebrow|render,
        body: content.field_body|render,
        link: {
          url: content.field_link[0]['#url'],
          text: content.field_link[0]['#title'],
        },
        link2: {
          url: content.field_link2[0]['#url'],
          text: content.field_link2[0]['#title'],
        },
      } only
    %}
  {% endblock %}
</div>
