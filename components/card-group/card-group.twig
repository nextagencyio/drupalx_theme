<div classname="space-y-6 lg:space-y-8">

	{% if section_title %}
		<h2 class="text-3xl lg:text-3xl font-bold text-center mb-8 lg:mb-8 w-3/5 mx-auto">{{ section_title }}</h2>
	{% endif %}

	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-12">
		{% block card_items %}
			{% for item in card_items %}
				<div class="mb-4">
					{% if item.card %}
						{%
							include '@drupalx_theme/card/card.twig' with {
								"card": item.card
							} only
						%}
					{% else %}
						{% include '@drupalx_theme/stat-card/stat-card.twig' with {
								media: item.media,
								heading: item.heading,
								body: item.body,
								link: item.link,
								icon: item.icon,
							} only
						%}
					{% endif %}
				</div>
			{% endfor %}
		{% endblock %}
	</div>
</div>
